---
import SectionHead from './SectionHead.astro';
import { profile } from '../data/profile';
const { links } = profile;

const channels = [
  { label: 'Email', value: links.email, href: `mailto:${links.email}` },
  { label: 'LinkedIn', value: 'savitha-vijayarangan', href: links.linkedin },
  { label: 'GitHub', value: 'IamSavitha', href: links.github },
  { label: 'Resume', value: 'One-page PDF', href: links.resume },
];
---

<section class="section contact" id="contact">
  <div class="container">
    <SectionHead title="Let's Connect" subtitle="Open to ML/AI, data and software engineering roles." />
    <ul class="channels">
      {channels.map(({ label, value, href }, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a class="card channel" href={href}>
            <span class="label">{label}</span>
            <span class="value">{value}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact { border-top: 1px solid var(--border); background: radial-gradient(50rem 20rem at 50% 120%, rgba(249, 115, 22, 0.12), transparent 70%); }
  .channels {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1rem; max-width: 960px; margin: 0 auto; padding: 0; list-style: none;
  }
  .channel { display: flex; flex-direction: column; gap: 0.3rem; height: 100%; padding: 1.25rem; text-decoration: none; }
  .label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .value { color: var(--text); overflow-wrap: anywhere; }
  .channel:hover .value { color: var(--accent-text); }
</style>
