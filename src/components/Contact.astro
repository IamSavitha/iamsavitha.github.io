---
import { profile } from '../data/profile';
const { links } = profile;

// Lucide icon paths (MIT), drawn inline so the page needs no icon library.
const icons = {
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  send: '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>',
};

const channels = [
  { icon: icons.mail, label: 'Email', value: links.email, href: `mailto:${links.email}` },
  { icon: icons.linkedin, label: 'LinkedIn', value: 'Connect on LinkedIn', href: links.linkedin },
  { icon: icons.github, label: 'GitHub', value: 'Follow on GitHub', href: links.github },
  { icon: icons.file, label: 'Resume', value: 'Download the one-page PDF', href: links.resume },
];
---

<section class="section contact" id="contact">
  <div class="container">
    <header class="head" data-reveal>
      <h2>Get in <span>Touch</span></h2>
      <p>Have a role, a project or a collaboration in mind? I'd love to hear from you.</p>
    </header>

    <div class="layout">
      <form class="card form" data-contact data-email={links.email} data-reveal action={`mailto:${links.email}`} method="post" enctype="text/plain">
        <h3>Send a Message</h3>
        <label>
          <span>Name</span>
          <input name="name" type="text" autocomplete="name" placeholder="Your name" required />
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" placeholder="your.email@example.com" required />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="5" placeholder="Tell me about the role or project..." required></textarea>
        </label>
        <button class="btn primary send" type="submit">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.send} />
          Send Message
        </button>
        <p class="note">Opens your email app with the message ready to send.</p>
      </form>

      <div class="side">
        <div class="card connect" data-reveal style="--i:1">
          <h3>Connect With Me</h3>
          <p class="lead">Feel free to reach out through any of these channels.</p>
          <ul>
            {channels.map(({ icon, label, value, href }) => (
              <li>
                <a class="channel" href={href}>
                  <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} /></span>
                  <span class="text">
                    <span class="label">{label}</span>
                    <span class="value">{value}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="card open" data-reveal style="--i:2">
          <h3><span class="dot" aria-hidden="true"></span>Open to Opportunities</h3>
          <p>
            I'm actively seeking <strong>ML/AI, data and software engineering roles</strong> at the intersection of
            model development, data infrastructure and real-world deployment.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--border);
    background:
      radial-gradient(45rem 22rem at 15% 0%, rgba(243, 198, 209, 0.35), transparent 65%),
      radial-gradient(40rem 22rem at 90% 100%, rgba(201, 216, 234, 0.4), transparent 65%);
  }
  .head { margin: 0 auto 3rem; text-align: center; }
  .head h2 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .head h2 span {
    background: linear-gradient(90deg, var(--indigo), var(--accent));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .head p { margin: 0.8rem 0 0; color: var(--muted); font-size: 1.1rem; }

  .layout { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .layout { grid-template-columns: 1.6fr 1fr; align-items: start; } }
  h3 { margin: 0; font-size: 1.3rem; letter-spacing: -0.01em; }

  /* Form */
  .form { display: grid; gap: 1.1rem; padding: 1.75rem; }
  @media (min-width: 640px) { .form { padding: 2.25rem; } }
  .form h3 { margin-bottom: 0.4rem; }
  label { display: grid; gap: 0.45rem; font-size: 0.9rem; font-weight: 500; }
  input, textarea {
    width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 10px;
    background: var(--surface-2); color: var(--text); font: inherit; font-weight: 400;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }
  textarea { resize: vertical; min-height: 7.5rem; }
  input::placeholder, textarea::placeholder { color: #9a938a; }
  input:focus, textarea:focus { outline: none; border-color: var(--accent); background: var(--surface); box-shadow: 0 0 0 4px var(--sakura-soft); }
  .send { width: 100%; padding-block: 0.85rem; border-radius: 12px; margin-top: 0.3rem; }
  .send svg, .icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .note { margin: -0.3rem 0 0; font-size: 0.8rem; color: var(--muted); text-align: center; }

  /* Side cards */
  .side { display: grid; gap: 1.5rem; }
  .connect, .open { padding: 1.75rem; }
  .lead { margin: 0.6rem 0 1.25rem; color: var(--muted); }
  .connect ul { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .channel {
    display: flex; align-items: center; gap: 0.9rem; padding: 0.85rem 1rem; border-radius: 12px;
    background: var(--surface-2); color: var(--text); text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .channel:hover { background: var(--sakura-soft); transform: translateX(3px); }
  .icon {
    display: grid; place-items: center; flex: none; width: 42px; height: 42px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--border); color: var(--accent);
  }
  .text { display: grid; min-width: 0; }
  .label { font-weight: 600; }
  .value { color: var(--muted); font-size: 0.88rem; overflow-wrap: anywhere; }

  .open { background: linear-gradient(135deg, #f1f5fa, #fbeef2); border-color: #dfe6ef; }
  .open h3 { display: flex; align-items: center; gap: 0.6rem; }
  .open p { margin: 0.9rem 0 0; color: #3a3632; }
  .open strong { color: var(--indigo); }
  .dot { position: relative; width: 10px; height: 10px; border-radius: 50%; background: var(--matcha); }
  .dot::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--matcha);
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping { 75%, 100% { transform: scale(2.4); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .dot::after { animation: none; } }
</style>
