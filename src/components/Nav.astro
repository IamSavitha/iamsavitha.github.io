---
import { profile } from '../data/profile';

const links = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#contact', label: 'Contact' },
];
---

<nav class="nav" aria-label="Main">
  <div class="inner container">
    <a class="brand" href="/">
      <span class="short" aria-hidden="true">SV</span>
      <span class="full">{profile.name.toUpperCase()}</span>
    </a>
    <ul>
      {links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
      <li><a class="resume" href={profile.links.resume}>Resume</a></li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--nav-h);
    border-bottom: 1px solid var(--accent-border);
    background: rgba(10, 10, 11, 0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; }
  .brand { color: var(--text); text-decoration: none; font-weight: 700; letter-spacing: 0.08em; font-size: 0.95rem; white-space: nowrap; }
  .brand .short { color: var(--accent); }
  .brand .full { display: none; }
  ul { display: flex; align-items: center; gap: 0.15rem; margin: 0; padding: 0; list-style: none; overflow-x: auto; scrollbar-width: none; }
  ul::-webkit-scrollbar { display: none; }
  a:not(.brand) {
    display: block; padding: 0.4rem 0.55rem; border-radius: 8px;
    color: var(--muted); text-decoration: none; font-size: 0.85rem; white-space: nowrap;
  }
  a:not(.brand):hover { color: var(--text); background: rgba(255, 255, 255, 0.05); }
  .resume { border: 1px solid var(--accent-border); color: var(--accent-text) !important; margin-left: 0.25rem; }
  @media (min-width: 720px) {
    .brand .short { display: none; }
    .brand .full { display: inline; }
    a:not(.brand) { padding: 0.45rem 0.8rem; font-size: 0.9rem; }
  }
</style>
