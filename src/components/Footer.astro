---
import { profile } from '../data/profile';
---

<footer class="footer">
  <div class="container inner">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding-block: 1.5rem; font-size: 0.85rem; color: var(--muted); }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; }
  p { margin: 0; }
  a { color: var(--muted); text-decoration: none; }
  a:hover { color: var(--accent); }
</style>
