---
import type { Metric } from '../lib/projectSchema';

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<dl class="metrics">
  {metrics.map(({ label, value }) => (
    <div>
      <dt>{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>

<style>
  .metrics {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 1px; margin: 1.75rem 0 1.5rem; overflow: hidden;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--border);
  }
  .metrics div { padding: 1.1rem 1.2rem; background: var(--surface); }
  dt { font-size: 0.8rem; color: var(--muted); }
  dd { margin: 0.3rem 0 0; font: 600 1.2rem/1.3 var(--font-mono); color: var(--accent-text); }
</style>
