---
import { Image } from 'astro:assets';
import portrait from '../assets/profile/savitha.jpg';
import { profile } from '../data/profile';
const { name, pitch, location, about, workAuthorization } = profile;
---

<section class="hero" id="top">
  <div class="aurora" aria-hidden="true"></div>
  <svg class="spotlight" aria-hidden="true" viewBox="0 0 3787 2842" fill="none">
    <g filter="url(#spotlight-blur)">
      <ellipse
        cx="1924.71" cy="273.501" rx="1924.71" ry="273.501"
        transform="matrix(-0.822377 -0.568943 -0.568943 0.822377 3631.88 2291.09)"
        fill="#f3a6b8" fill-opacity="0.32"
      />
    </g>
    <defs>
      <filter id="spotlight-blur" x="0.86" y="0.84" width="3785.16" height="2840.26" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
        <feFlood flood-opacity="0" result="BackgroundImageFix" />
        <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape" />
        <feGaussianBlur stdDeviation="151" result="blur" />
      </filter>
    </defs>
  </svg>
  <canvas class="sparkles" data-sparkles aria-hidden="true"></canvas>

  <div class="container inner">
    <div class="title">
      <div class="avatar">
        <Image src={portrait} alt={`Portrait of ${name}`} width={420} widths={[140, 280, 420]} sizes="140px" loading="eager" fetchpriority="high" />
      </div>
      <p class="location">{location}</p>
      <h1 class="shimmer">{name}</h1>
      <p class="auth"><span class="check" aria-hidden="true">✓</span>{workAuthorization}</p>
      <p class="pitch" aria-label={pitch}>
        {pitch.split(' ').map((word, i) => <span class="word" aria-hidden="true" style={`--i:${i}`}>{word} </span>)}
      </p>
    </div>

    <div class="stage">
      <div class="screen" data-scroll-tilt>
        <div class="screen-inner">
          <div class="lamp" aria-hidden="true">
            <div class="beam"></div>
            <div class="glow"></div>
            <div class="line"></div>
          </div>
          <div class="content">
            {about.map((paragraph) => <p>{paragraph}</p>)}
            <div class="actions">
              <a class="btn primary" href="#projects">View My Work</a>
              <a class="btn ghost" href="#contact">Get In Touch</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    padding-block: calc(var(--nav-h) + 3.5rem) 5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  /* Background layers: pastel aurora, soft rose spotlight, sparkles */
  .aurora {
    position: absolute; inset: -10%; z-index: -3; opacity: 0.55; filter: blur(70px);
    background-image:
      repeating-linear-gradient(100deg, var(--bg) 0%, var(--bg) 7%, transparent 10%, transparent 12%, var(--bg) 16%),
      repeating-linear-gradient(100deg, #f3c6d1 10%, #c9d8ea 15%, #f7dde3 20%, #dbe6d0 25%, #f3c6d1 30%);
    background-size: 300%, 200%;
    background-position: 50% 50%, 50% 50%;
    mask-image: radial-gradient(ellipse at 100% 0%, black 10%, transparent 65%);
    -webkit-mask-image: radial-gradient(ellipse at 100% 0%, black 10%, transparent 65%);
    animation: aurora 60s linear infinite;
  }
  .spotlight {
    position: absolute; z-index: -2; pointer-events: none;
    top: -40%; left: 0; width: 138%; height: 169%;
    opacity: 0; animation: spotlight 2s 0.75s ease forwards;
  }
  @media (min-width: 768px) { .spotlight { top: -20%; left: 15%; } }
  @media (min-width: 1024px) { .spotlight { width: 84%; } }
  .sparkles { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }

  /* Portrait with a slowly rotating soft ring */
  .avatar {
    position: relative; isolation: isolate; width: 112px; height: 112px; margin: 0 auto 1.25rem; padding: 4px; border-radius: 50%;
    box-shadow: 0 10px 30px -10px rgba(176, 58, 91, 0.35);
    animation: avatar-in 0.8s 0.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @media (min-width: 768px) { .avatar { width: 140px; height: 140px; } }
  .avatar::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 50%;
    background: conic-gradient(#f3c6d1, #c9d8ea, #b03a5b, #264b73, #f3c6d1);
    animation: ring-spin 9s linear infinite;
  }
  .avatar :global(img) {
    width: 100%; height: 100%; border-radius: 50%; border: 3px solid var(--bg);
    object-fit: cover; object-position: 50% 50%; background: var(--surface-2);
  }
  @keyframes ring-spin { to { transform: rotate(1turn); } }
  @keyframes avatar-in { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: none; } }

  /* Name and tagline */
  .title { text-align: center; }
  .location { margin: 0; font: 600 0.78rem var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  h1 {
    margin: 0.75rem 0 0.5rem; font-size: clamp(1.5rem, 8vw, 6rem); line-height: 1.04;
    font-weight: 800; letter-spacing: -0.03em; text-transform: uppercase; overflow-wrap: anywhere;
  }
  .auth {
    display: inline-flex; align-items: center; gap: 0.45rem; margin: 0.35rem 0 1rem;
    padding: 0.3rem 0.85rem 0.3rem 0.4rem; border: 1px solid #d6e2cb; border-radius: 999px;
    background: #f2f6ee; color: #3f5a2c; font-size: 0.88rem; font-weight: 500;
    animation: word-in 0.6s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .check {
    display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%;
    background: var(--matcha); color: #fff; font-size: 0.72rem; font-weight: 700;
  }
  .pitch { margin: 0 auto; max-width: 40ch; font-size: clamp(1.05rem, 2.4vw, 1.35rem); color: var(--indigo); font-weight: 500; }
  .word { display: inline-block; white-space: pre; animation: word-in 0.6s calc(0.4s + var(--i) * 0.08s) cubic-bezier(0.2, 0.7, 0.2, 1) both; }

  /* Ink-dark screen that flattens as you scroll */
  .stage { margin-top: 3rem; perspective: 1200px; }
  .screen {
    --tilt: 12deg; --scale: 0.94;
    max-width: 980px; margin-inline: auto; padding: 0.4rem;
    border: 4px solid #d9d1c5; border-radius: 22px; background: #efe9e0;
    transform: rotateX(var(--tilt)) scale(var(--scale)); transform-origin: 50% 0%;
    will-change: transform;
    box-shadow: 0 9px 20px rgba(31, 29, 27, 0.12), 0 37px 37px rgba(31, 29, 27, 0.1), 0 84px 50px rgba(31, 29, 27, 0.06), 0 0 90px rgba(243, 166, 184, 0.25);
  }
  @media (min-width: 768px) { .screen { --tilt: 18deg; --scale: 1.03; padding: 0.9rem; border-radius: 30px; } }
  .screen-inner { position: relative; overflow: hidden; border-radius: 16px; background: #1c1a1f; }

  /* Rose lamp */
  .lamp { position: relative; height: 9rem; overflow: hidden; pointer-events: none; }
  .beam {
    position: absolute; top: 2.5rem; left: 50%; height: 12rem; width: 12rem; transform: translateX(-50%);
    background: conic-gradient(from 90deg at 50% 0%, #f3a6b8 0deg, transparent 65deg, transparent 115deg, #f3a6b8 180deg);
    mask-image: radial-gradient(ellipse 50% 100% at 50% 0%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 50% 100% at 50% 0%, black 20%, transparent 75%);
    opacity: 0.35; animation: lamp-beam 1.4s 0.3s ease-in-out forwards;
  }
  .glow {
    position: absolute; top: 1rem; left: 50%; height: 5rem; width: 10rem; transform: translateX(-50%);
    border-radius: 999px; background: #f3a6b8; filter: blur(40px); opacity: 0.25;
    animation: lamp-glow 1.4s 0.3s ease-in-out forwards;
  }
  .line {
    position: absolute; top: 2.5rem; left: 50%; height: 2px; width: 4rem; transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, #fde3ea, transparent);
    box-shadow: 0 0 24px rgba(243, 166, 184, 0.9);
    opacity: 0.5; animation: lamp-line 1.4s 0.3s ease-in-out forwards;
  }
  .content { position: relative; margin-top: -3.5rem; padding: 0 1.25rem 2rem; text-align: center; }
  @media (min-width: 768px) { .content { padding: 0 3rem 3rem; } }
  .content p { max-width: 68ch; margin: 0 auto 1rem; color: #e9e3dc; font-size: 1.02rem; }
  .actions { position: relative; z-index: 2; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.75rem; }
  .btn.primary { background: #f3a6b8; border-color: #f3a6b8; color: #2a1119; }
  .btn.primary:hover { background: #f7bccb; border-color: #f7bccb; }
  .btn.ghost { background: transparent; border-color: rgba(233, 227, 220, 0.3); color: #f4efe9; }
  .btn.ghost:hover { border-color: #f3a6b8; }

  @keyframes lamp-beam { to { width: min(34rem, 100%); opacity: 0.6; } }
  @keyframes lamp-glow { to { width: min(26rem, 90%); opacity: 0.45; } }
  @keyframes lamp-line { to { width: min(30rem, 90%); opacity: 1; } }
  @keyframes word-in { from { opacity: 0; filter: blur(8px); transform: translateY(8px); } to { opacity: 1; filter: none; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .aurora, .spotlight, .beam, .glow, .line, .word, .auth, .avatar, .avatar::before { animation: none; }
    .spotlight { opacity: 1; }
    .beam { width: min(34rem, 100%); opacity: 0.6; }
    .glow { width: min(26rem, 90%); opacity: 0.45; }
    .line { width: min(30rem, 90%); opacity: 1; }
    .screen { --tilt: 0deg; --scale: 1; }
  }
</style>
