---
import { profile } from '../data/profile';
const { name, pitch, location, about } = profile;
---

<section class="hero" id="top">
  <div class="container">
    <p class="location">{location}</p>
    <h1>{name}</h1>
    <p class="pitch">{pitch}</p>
    <div class="about">
      {about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="actions">
      <a class="btn primary" href="#projects">View My Work</a>
      <a class="btn" href="#contact">Get In Touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden;
    padding-block: calc(var(--nav-h) + 4.5rem) 4rem;
    background:
      radial-gradient(60rem 30rem at 15% -10%, rgba(249, 115, 22, 0.18), transparent 60%),
      radial-gradient(40rem 24rem at 95% 10%, rgba(251, 146, 60, 0.08), transparent 60%);
    border-bottom: 1px solid var(--border);
  }
  .location { margin: 0; font: 0.8rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  h1 {
    margin: 0.75rem 0 0.5rem; font-size: clamp(2.4rem, 8vw, 5.25rem); line-height: 1.02;
    font-weight: 800; letter-spacing: -0.03em; text-transform: uppercase;
  }
  .pitch { margin: 0 0 1.75rem; font-size: clamp(1.1rem, 2.4vw, 1.4rem); color: var(--accent-text); font-weight: 500; }
  .about { max-width: 68ch; }
  .about p { margin: 0 0 1rem; color: #d4d4d8; font-size: 1.02rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
